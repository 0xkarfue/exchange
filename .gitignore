# ==============================================================================
# SECURITY & EXCHANGE SECRETS (CRITICAL)
# ==============================================================================
# Environment files & local configs
.env
.env.*
!.env.example
config/local.*
config/production.*
secrets/

# Private keys, certificates, and wallet files
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
*.jks
*wallet*.json
*mnemonic*
*private_key*
*secret*

# ==============================================================================
# RUST (TRADING / MATCHING ENGINE)
# ==============================================================================
# Generated by Cargo
/target/
**/target/

# Debug files & crash dumps
*.pdb
*.dSYM/
*.core
core.*

# Uncomment Cargo.lock if your engine is a library; KEEP IT TRACKED if it's a binary/service!
# Cargo.lock

# ==============================================================================
# TYPESCRIPT / NODE.JS (BACKEND & FRONTEND)
# ==============================================================================
# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
*.tsbuildinfo

# Package manager caches & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# ==============================================================================
